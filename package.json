  "description": "Read-only checkup of a PostgreSQL database, run on your machine. Nothing leaves it unless you say so.",
  "type": "module",
  "bin": {
    "pg-checkup": "dist/pg-checkup.js"
  },
  "files": [
    "dist",
    "source",
    "source-manifest.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pgcheckup/pg-checkup.git"
  },
